<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Catppuccin palettes. Accent roles are set below and overridden at runtime by AccentTheme. -->
    <style name="Theme.Catppuccin.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Accent roles: colorPrimary defaults to the default accent and is replaced per accent
             by ThemeOverlay.ReMetro.Accent.* (styles_accent.xml); other roles follow it. -->
        <item name="colorPrimary">@color/ctp_mocha_sapphire</item>
        <item name="colorOnPrimary">@color/ctp_mocha_base</item>
        <item name="colorPrimaryContainer">?attr/colorPrimary</item>
        <item name="colorOnPrimaryContainer">?attr/colorOnPrimary</item>
        <item name="colorPrimaryInverse">?attr/colorPrimary</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorOnSecondary">?attr/colorOnPrimary</item>
        <item name="colorTertiary">?attr/colorPrimary</item>
        <item name="colorOnTertiary">?attr/colorOnPrimary</item>
