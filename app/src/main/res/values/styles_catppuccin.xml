        <item name="colorSecondaryContainer">@color/ctp_mocha_surface1</item>
        <item name="colorOnSecondaryContainer">@color/ctp_mocha_text</item>
        <item name="colorSurfaceInverse">@color/ctp_mocha_text</item>
        <item name="colorOnSurfaceInverse">@color/ctp_mocha_base</item>
        <item name="android:textColorPrimary">@color/text_primary_mocha</item>
        <item name="android:textColorSecondary">@color/text_secondary_mocha</item>
        <item name="android:textColorTertiary">@color/ctp_mocha_overlay1</item>
        <item name="android:textColorHint">@color/ctp_mocha_overlay0</item>
    </style>

