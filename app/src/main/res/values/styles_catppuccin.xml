<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Catppuccin palettes. Accent (colorPrimary etc.) is applied at runtime by ThemeStore/ATH. -->
    <style name="Theme.Catppuccin.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorBackground">@color/ctp_mocha_base</item>
        <item name="colorSurface">@color/ctp_mocha_base</item>
        <item name="colorOnSurface">@color/ctp_mocha_text</item>
        <item name="colorOnBackground">@color/ctp_mocha_text</item>
        <item name="colorSurfaceVariant">@color/ctp_mocha_surface0</item>
        <item name="colorOnSurfaceVariant">@color/ctp_mocha_subtext0</item>
        <item name="colorOutline">@color/ctp_mocha_overlay0</item>
        <item name="colorOutlineVariant">@color/ctp_mocha_surface1</item>
        <item name="colorError">@color/ctp_mocha_red</item>
        <item name="colorOnError">@color/ctp_mocha_crust</item>
        <item name="colorSurfaceDim">@color/ctp_mocha_mantle</item>
        <item name="colorSurfaceBright">@color/ctp_mocha_surface1</item>
        <item name="colorSurfaceContainerLowest">@color/ctp_mocha_crust</item>
        <item name="colorSurfaceContainerLow">@color/ctp_mocha_mantle</item>
        <item name="colorSurfaceContainer">@color/ctp_mocha_surface0</item>
        <item name="colorSurfaceContainerHigh">@color/ctp_mocha_surface1</item>
        <item name="colorSurfaceContainerHighest">@color/ctp_mocha_surface2</item>
        <item name="colorSecondaryContainer">@color/ctp_mocha_surface1</item>
        <item name="colorOnSecondaryContainer">@color/ctp_mocha_text</item>
        <item name="colorSurfaceInverse">@color/ctp_mocha_text</item>
        <item name="colorOnSurfaceInverse">@color/ctp_mocha_base</item>
        <item name="android:textColorPrimary">@color/text_primary_mocha</item>
        <item name="android:textColorSecondary">@color/text_secondary_mocha</item>
        <item name="android:textColorTertiary">@color/ctp_mocha_overlay1</item>
        <item name="android:textColorHint">@color/ctp_mocha_overlay0</item>
    </style>

    <style name="Theme.Catppuccin.Black" parent="Theme.Catppuccin.Dark">
        <item name="android:colorBackground">@color/blackColorSurface</item>
        <item name="colorSurface">@color/blackColorSurface</item>
        <item name="colorSurfaceDim">@color/blackColorSurface</item>
        <item name="colorSurfaceContainerLowest">@color/blackColorSurface</item>
        <item name="colorSurfaceContainerLow">@color/ctp_mocha_crust</item>
    </style>

    <style name="Theme.Catppuccin.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/ctp_latte_base</item>
        <item name="colorSurface">@color/ctp_latte_base</item>
        <item name="colorOnSurface">@color/ctp_latte_text</item>
        <item name="colorOnBackground">@color/ctp_latte_text</item>
        <item name="colorSurfaceVariant">@color/ctp_latte_surface0</item>
        <item name="colorOnSurfaceVariant">@color/ctp_latte_subtext0</item>
        <item name="colorOutline">@color/ctp_latte_overlay0</item>
        <item name="colorOutlineVariant">@color/ctp_latte_surface1</item>
        <item name="colorError">@color/ctp_latte_red</item>
        <item name="colorOnError">@color/ctp_latte_crust</item>
        <item name="colorSurfaceDim">@color/ctp_latte_mantle</item>
        <item name="colorSurfaceBright">@color/ctp_latte_surface1</item>
        <item name="colorSurfaceContainerLowest">@color/ctp_latte_crust</item>
        <item name="colorSurfaceContainerLow">@color/ctp_latte_mantle</item>
        <item name="colorSurfaceContainer">@color/ctp_latte_surface0</item>
        <item name="colorSurfaceContainerHigh">@color/ctp_latte_surface1</item>
        <item name="colorSurfaceContainerHighest">@color/ctp_latte_surface2</item>
        <item name="colorSecondaryContainer">@color/ctp_latte_surface1</item>
        <item name="colorOnSecondaryContainer">@color/ctp_latte_text</item>
        <item name="colorSurfaceInverse">@color/ctp_latte_text</item>
        <item name="colorOnSurfaceInverse">@color/ctp_latte_base</item>
        <item name="android:textColorPrimary">@color/text_primary_latte</item>
        <item name="android:textColorSecondary">@color/text_secondary_latte</item>
        <item name="android:textColorTertiary">@color/ctp_latte_overlay1</item>
        <item name="android:textColorHint">@color/ctp_latte_overlay0</item>
    </style>

    <!-- Latte by default, Mocha with the night qualifier (via theme_* colors) -->
    <style name="Theme.Catppuccin.DayNight" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/theme_base</item>
        <item name="colorSurface">@color/theme_base</item>
        <item name="colorOnSurface">@color/theme_text</item>
        <item name="colorOnBackground">@color/theme_text</item>
        <item name="colorSurfaceVariant">@color/theme_surface0</item>
        <item name="colorOnSurfaceVariant">@color/theme_subtext0</item>
        <item name="colorOutline">@color/theme_overlay0</item>
        <item name="colorOutlineVariant">@color/theme_surface1</item>
        <item name="colorError">@color/theme_red</item>
        <item name="colorOnError">@color/theme_crust</item>
        <item name="colorSurfaceDim">@color/theme_mantle</item>
        <item name="colorSurfaceBright">@color/theme_surface1</item>
        <item name="colorSurfaceContainerLowest">@color/theme_crust</item>
        <item name="colorSurfaceContainerLow">@color/theme_mantle</item>
        <item name="colorSurfaceContainer">@color/theme_surface0</item>
        <item name="colorSurfaceContainerHigh">@color/theme_surface1</item>
        <item name="colorSurfaceContainerHighest">@color/theme_surface2</item>
        <item name="colorSecondaryContainer">@color/theme_surface1</item>
        <item name="colorOnSecondaryContainer">@color/theme_text</item>
        <item name="colorSurfaceInverse">@color/theme_text</item>
        <item name="colorOnSurfaceInverse">@color/theme_base</item>
        <item name="android:textColorPrimary">@color/text_primary_daynight</item>
        <item name="android:textColorSecondary">@color/text_secondary_daynight</item>
        <item name="android:textColorTertiary">@color/theme_overlay1</item>
        <item name="android:textColorHint">@color/theme_overlay0</item>
    </style>
</resources>
